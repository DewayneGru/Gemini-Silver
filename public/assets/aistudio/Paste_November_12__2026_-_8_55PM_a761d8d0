import React, { useCallback, useEffect, useMemo, useState } from "react";

const DEFAULT_DAEMON_URL = "[http://127.0.0.1:8765](http://127.0.0.1:8765)";

interface GovernorState {
  order_parameter_r: number;
  r_target: number;
  coupling_k: number;
  steering_directive: string;
}

interface TelemetryPayload {
  steering_mode_honored: string;
  claim_status: "VERIFIED" | "HYPOTHESIS" | string;
  core_mechanism: string;
  invariants_checked: string[];
  hidden_assumptions: string[];
  falsification_test: string;
  ready_for_ledger_commit: boolean;
}

interface DemotionProvenance {
  source_ledger?: string;
  prior_merkle_leaf?: string;
  prior_hmac_sha256?: string;
  signature_valid?: boolean;
}

interface LedgerEnvelope {
  prompt_id: string;
  timestamp_ms: number;
  governor?: GovernorState;
  telemetry?: TelemetryPayload;
  committed: boolean;
  quarantine_reason?: string | null;
  demoted_at_ms?: number;
  demotion_provenance?: DemotionProvenance;
}

interface SignedLedgerRecord {
  envelope?: LedgerEnvelope;
  merkle_leaf?: string;
  hmac_sha256?: string;
  _corrupt_line?: number;
  _error?: string;
  _raw?: string;
}

interface VerificationVerdict {
  prompt_id: string;
  merkle_leaf: string;
  verified_signature: boolean;
  passed: boolean;
  demoted_to_quarantine: boolean;
  failure_reason: string | null;
  cpp_metrics?: {
    alignment_64?: boolean;
    unit_suite?: {
      passed: boolean;
      duration_ms: number;
      exit_code: number;
    };
  };
  timestamp_ms: number;
}

interface SilverVerificationsState {
  ok: boolean;
  hmac_key_configured: boolean;
  counts: {
    committed: number;
    quarantined: number;
    verifications: number;
  };
  committed: SignedLedgerRecord[];
  quarantined: SignedLedgerRecord[];
  verifications: VerificationVerdict[];
}

interface VerifyRunReport {
  total_evaluated: number;
  kept_in_committed_ledger: number;
  demoted_to_quarantine: number;
  dry_run: boolean;
}

interface IngestAuditReceipt {
  timestamp_ms: number;
  merkle_leaf_hex: string;
  hmac_sha256_hex: string;
  order_parameter_r: number;
  coupling_k: number;
  steering_directive: string;
  committed: boolean;
  quarantine_reason: string | null;
}

export interface SilverVerificationPanelProps {
  daemonBaseUrl?: string;
  unitTestArgs?: string;
}

function truncateHash(hash?: string): string {
  if (!hash) return "unsigned";
  if (hash.length <= 16) return hash;
  return `${hash.slice(0, 10)}…${hash.slice(-8)}`;
}

function formatTimestamp(ms?: number): string {
  if (!ms) return "—";
  return new Date(ms).toLocaleTimeString([], {
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
  });
}

