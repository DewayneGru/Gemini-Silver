        ) : records.length === 0 ? (
          <div className="p-8 text-center text-xs text-zinc-500">
            No entries in {activeTab === "committed" ? "silver_committed_ledger.jsonl" : "silver_scratchpad_quarantine.jsonl"}.
          </div>
        ) : (
          records.map((rec, idx) => {
            if (rec._corrupt_line) {
              return (
                <div key={`corrupt-${idx}`} className="bg-rose-950/20 p-4 text-xs text-rose-300">
                  Corrupt JSONL line #{rec._corrupt_line}: {rec._error}
                </div>
              );
            }

            const env = rec.envelope;
            const promptId = env?.prompt_id ?? `entry-${idx + 1}`;
            const verdict = verdictByPrompt.get(promptId);
            const leaf = rec.merkle_leaf;
            const priorLeaf = env?.demotion_provenance?.prior_merkle_leaf;

            return (
              <div key={`${leaf ?? promptId}-${idx}`} className="space-y-2.5 p-4 hover:bg-zinc-900/40">
                <div className="flex flex-wrap items-center justify-between gap-2">
                  <div className="flex flex-wrap items-center gap-2">
                    <span className="font-mono text-xs font-semibold text-zinc-100">
                      {promptId}
                    </span>

                    {env?.telemetry?.claim_status && (
                      <span
                        className={`rounded px-2 py-0.5 font-mono text-[10px] font-semibold uppercase ${
                          env.telemetry.claim_status === "VERIFIED"
                            ? "border border-emerald-500/30 bg-emerald-500/15 text-emerald-300"
                            : "border border-amber-500/30 bg-amber-500/15 text-amber-300"
                        }`}
                      >
                        {env.telemetry.claim_status}
                      </span>
                    )}

                    {env?.governor && (
                      <span className="rounded border border-zinc-800 bg-zinc-900 px-2 py-0.5 font-mono text-[11px] text-zinc-300">
                        R={env.governor.order_parameter_r.toFixed(3)} · {env.governor.steering_directive}
                      </span>
                    )}

                    {verdict && (
                      <span
                        className={`rounded px-2 py-0.5 font-mono text-[10px] font-medium ${
                          verdict.passed
                            ? "border border-sky-500/30 bg-sky-500/15 text-sky-300"
                            : "border border-rose-500/30 bg-rose-500/15 text-rose-300"
                        }`}
                      >
                        C++20: {verdict.passed ? "PASS" : "FAIL"}
                      </span>
                    )}
                  </div>

                  <div className="flex items-center gap-2">
                    <span className="text-[11px] text-zinc-500">
                      {formatTimestamp(env?.timestamp_ms)}
                    </span>
                    <button
                      type="button"
                      onClick={() => void handleCopyLeaf(leaf)}
                      title={leaf ? `SHA-256("leaf:" || rawBody): ${leaf}` : "No Merkle leaf"}
                      className="inline-flex items-center gap-1 rounded border border-zinc-700/80 bg-zinc-900 px-2 py-0.5 font-mono text-[11px] text-zinc-300 hover:border-zinc-500 hover:text-white"
                    >
                      <span className="text-zinc-500">leaf:</span>
                      <span>{truncateHash(leaf)}</span>
                      {copiedLeaf === leaf && (
                        <span className="ml-1 text-[10px] text-emerald-400">copied</span>
                      )}
                    </button>
                  </div>
                </div>

                {env?.telemetry?.core_mechanism && (
                  <p className="text-xs leading-relaxed text-zinc-200">
                    {env.telemetry.core_mechanism}
                  </p>
                )}

                {env?.telemetry?.falsification_test && (
                  <div className="rounded-lg border border-zinc-800/90 bg-zinc-900/70 px-3 py-2 font-mono text-[11px] text-zinc-300">
                    <span className="mr-1.5 text-zinc-500">Falsification:</span>
                    {env.telemetry.falsification_test}
                  </div>
                )}

                {(env?.quarantine_reason || verdict?.failure_reason) && (
                  <div className="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-rose-500/30 bg-rose-950/30 px-3 py-2 text-xs text-rose-200">
                    <span>
                      <strong>Reason:</strong> {verdict?.failure_reason || env?.quarantine_reason}
                    </span>
                    {priorLeaf && (
                      <span className="font-mono text-[11px] text-rose-300/80">
                        prior_leaf: {truncateHash(priorLeaf)}
                      </span>
                    )}
                  </div>
                )}
              </div>
            );
          })
        )}
      </div>
    </section>
  );
};

export default SilverVerificationPanel;